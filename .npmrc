# better-auth declares optional peer dependencies on other frameworks'
# integrations (TanStack Start → Vite → Babel 8 RC) that conflict with the
# Babel 7 already in this tree. We use none of them. npm's strict peer
# resolution refuses the install; pnpm (used by the PixFlow reference repo)
# tolerates it. Keep local, CI and Vercel installs consistent.
legacy-peer-deps=true
