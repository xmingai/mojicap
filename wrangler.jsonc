{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mojicap",
  // Our own entry: OpenNext's generated worker, the canonical-host redirect,
  // and a scheduled() handler for the daily report. See cloudflare/worker.ts.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  // Smaller script, less isolate memory: V8 keeps the source text on the heap.
  "minify": true,
  // nodejs_compat: better-auth, the Waffo SDK's RSA signing (node:crypto) and
  // Next's proxy.ts, which Next 16 only runs on the Node.js runtime.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Both hostnames are proxied records in the mojicap.com zone, so routes take
  // their traffic without touching DNS - and removing a route hands it
  // straight back to whatever the record points at (Vercel, until it is
  // retired). The bare domain only ever redirects to www (cloudflare/worker.ts).
  "routes": [
    { "pattern": "www.mojicap.com/*", "zone_name": "mojicap.com" },
    { "pattern": "mojicap.com/*", "zone_name": "mojicap.com" }
  ],
  // No second public copy of the site on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mojicap"
    }
  ],
  // ISR (emoji pages outside English render on first visit) and the data cache.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mojicap-next-cache"
    }
  ],
  // 01:00 UTC = 09:00 Beijing, the same slot the Vercel cron used.
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  // Configuration that is not secret. Secrets are set with `wrangler secret put`
  // and never live in this file or in any .env that reaches a build.
  "vars": {
    "BETTER_AUTH_URL": "https://www.mojicap.com",
    "EMAIL_FROM": "MojiCap <noreply@mojicap.com>",
    "WAFFO_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
